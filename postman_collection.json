{
  "info": {
    "name": "Teacher Session Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for the teacher session booking backend."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Rahul Verma\",\n  \"email\": \"rahul@example.com\",\n  \"phone\": \"9876543210\"\n}"
        }
      }
    },
    {
      "name": "2. Create Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-10-25T10:00:00.000Z\",\n  \"endTime\": \"2026-10-25T11:00:00.000Z\"\n}"
        }
      }
    },
    {
      "name": "3. Available Sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp=1761379200000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "available"
          ],
          "query": [
            {
              "key": "dateTimestamp",
              "value": "1761379200000"
            }
          ]
        }
      }
    },
    {
      "name": "4. Book Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "book"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        }
      }
    },
    {
      "name": "5. Complete Session",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "complete"
          ]
        }
      }
    },
    {
      "name": "6. User Sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "sessions"
          ]
        }
      }
    }
  ]
}